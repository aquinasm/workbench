        },
        "windows-x86_64": {
          "url": "https://archive.mariadb.org/mariadb-12.3.4/winx64-packages/mariadb-12.3.4-winx64.zip",
          "format": "zip",
          "strip_components": 1
        }
      }
    },
    {
      "id": "redis",
      "name": "Redis",
      "version": "8.2.11",
      "description": "In-memory cache & queue broker for Laravel Horizon / queues",
      "default_port": 6379,
      "size_hint_mb": 8,
      "targets": {
        "windows-x86_64": {
          "url": "https://github.com/tporadowski/redis/releases/download/v5.0.14.1/Redis-x64-5.0.14.1.zip",
          "format": "zip",
          "strip_components": 0
        }
      }
    },
    {
      "id": "apache",
      "name": "Apache HTTP",
      "version": "2.4.71",
      "description": "Apache HTTP Server with full .htaccess support for PHP/Laravel apps",
      "default_port": 8081,
      "size_hint_mb": 18,
      "targets": {}
    }
