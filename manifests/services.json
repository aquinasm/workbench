{
  "schema_version": 1,
  "services": [
    {
      "id": "caddy",
      "name": "Caddy",
      "version": "2.11.9",
      "description": "Modern web server with automatic local HTTPS & reverse proxy",
      "default_port": 8080,
      "size_hint_mb": 16,
      "targets": {
        "macos-aarch64": {
          "url": "https://github.com/caddyserver/caddy/releases/download/v2.11.9/caddy_2.11.9_mac_arm64.tar.gz",
          "format": "tar.gz",
          "strip_components": 0
        },
        "linux-x86_64": {
          "url": "https://github.com/caddyserver/caddy/releases/download/v2.11.9/caddy_2.11.9_linux_amd64.tar.gz",
          "format": "tar.gz",
          "strip_components": 0
        },
        "windows-x86_64": {
          "url": "https://github.com/caddyserver/caddy/releases/download/v2.11.9/caddy_2.11.9_windows_amd64.zip",
          "format": "zip",
          "strip_components": 0
        }
      }
    },
    {
      "id": "phpmyadmin",
      "name": "phpMyAdmin",
      "version": "5.2.3",
      "description": "Web administration interface for all running MariaDB instances",
      "default_port": 8088,
      "size_hint_mb": 14,
      "targets": {
        "macos-aarch64": {
          "url": "https://files.phpmyadmin.net/phpMyAdmin/5.2.3/phpMyAdmin-5.2.3-all-languages.zip",
          "format": "zip",
          "strip_components": 1
        },
        "linux-x86_64": {
          "url": "https://files.phpmyadmin.net/phpMyAdmin/5.2.3/phpMyAdmin-5.2.3-all-languages.zip",
          "format": "zip",
          "strip_components": 1
        },
        "windows-x86_64": {
          "url": "https://files.phpmyadmin.net/phpMyAdmin/5.2.3/phpMyAdmin-5.2.3-all-languages.zip",
          "format": "zip",
          "strip_components": 1
        }
      }
    },
    {
      "id": "mariadb",
      "name": "MariaDB",
      "version": "12.3.4",
      "description": "MariaDB 12.3 LTS with isolated per-version data directory",
      "default_port": 3306,
      "size_hint_mb": 120,
      "targets": {
        "linux-x86_64": {
          "url": "https://archive.mariadb.org/mariadb-12.3.4/bintar-linux-systemd-x86_64/mariadb-12.3.4-linux-systemd-x86_64.tar.gz",
          "format": "tar.gz",
