{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Workbench main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "dialog:allow-open",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://127.0.0.1:*" },
        { "url": "http://localhost:*" },
        { "url": "http://*.test" },
        { "url": "http://*.test:*" },
        { "url": "http://192.168.*" },
        { "url": "http://10.*" },
        { "url": "http://172.*" },
        { "url": "https://*" }
      ]
    }
  ]
}
